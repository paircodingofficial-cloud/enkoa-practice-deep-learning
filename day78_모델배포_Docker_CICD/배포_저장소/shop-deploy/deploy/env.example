# deploy/.env 의 모양입니다. 값은 과제 01 3번 노트북이 만들어 scp 로 올립니다. .env 는 저장소에 올리지 않습니다(.gitignore)
# 이미지 이름: ghcr.io/<GitHub 계정 이름(소문자)>/shop-deploy
SHOP_IMAGE=ghcr.io/your-github-id/shop-deploy
# 교안 02 에서 만든 RunPod GPU 파드의 vLLM 주소(끝에 /v1)와 키
VLLM_BASE_URL=https://YOUR-GPU-POD-ID-8000.proxy.runpod.net/v1
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=90
