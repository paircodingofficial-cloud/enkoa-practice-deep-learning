# deploy/.env 의 모양. 값은 교안 02 노트북이 만들어 scp 로 올린다. .env 는 저장소에 올리지 않는다(.gitignore)
# compose.yaml 이 이 파일을 두 번 읽는다. image 줄의 ${SERVING_IMAGE} 를 채우고, env_file 로 모든 줄을 컨테이너 환경 변수로 넣는다
# 값 뒤에 주석을 붙이면 값의 일부가 되므로 설명은 각 이름 위에 적는다

# image 줄의 ${SERVING_IMAGE} 에 들어갈 이미지 이름: ghcr.io/<GitHub 계정 이름>/serving-deploy
# GHCR 은 소문자만 받으므로 계정 이름을 소문자로 적는다
SERVING_IMAGE=ghcr.io/your-github-id/serving-deploy
# RunPod GPU 파드의 vLLM proxy 주소. YOUR-GPU-POD-ID 자리에 콘솔의 파드 ID 를 넣는다
# 서빙 API 가 뒤에 /chat/completions 를 붙이므로 끝을 /v1 로 둔다
VLLM_BASE_URL=https://YOUR-GPU-POD-ID-8000.proxy.runpod.net/v1
# GPU 파드의 환경 변수 VLLM_API_KEY 와 같은 값을 넣는다
VLLM_API_KEY=
# 관리자 주소(/v1/admin/keys)에 X-Admin-Key 헤더로 보낼 키
ADMIN_API_KEY=
# vLLM 답을 기다리는 최대 시간(초). RunPod proxy 는 100초를 넘기면 끊으므로 그보다 짧게 둔다
VLLM_TIMEOUT_SECONDS=90
