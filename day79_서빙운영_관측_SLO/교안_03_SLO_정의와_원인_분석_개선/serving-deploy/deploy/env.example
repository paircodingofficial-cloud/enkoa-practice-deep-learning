# deploy/.env 의 모양입니다. 값은 교안 02 노트북이 만들어 scp 로 올립니다. .env 는 저장소에 올리지 않습니다(.gitignore)
# 이미지 이름: ghcr.io/<GitHub 계정 이름(소문자)>/serving-deploy
SERVING_IMAGE=ghcr.io/your-github-id/serving-deploy
# RunPod GPU 파드의 vLLM 주소(끝에 /v1)
VLLM_BASE_URL=https://YOUR-GPU-POD-ID-8000.proxy.runpod.net/v1
VLLM_API_KEY=
ADMIN_API_KEY=
# RunPod proxy 는 100초를 넘기면 끊으므로 그보다 짧게 둔다
VLLM_TIMEOUT_SECONDS=90

# Langfuse 프로젝트 키와 주소(관측 단원 교안 02). 내 PC 의 실습자료/.env 와 같은 값
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 이 서버가 남기는 기록의 환경 이름(Langfuse 화면의 Environment 필터)
LANGFUSE_TRACING_ENVIRONMENT=production
